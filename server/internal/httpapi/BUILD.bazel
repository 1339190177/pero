load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "httpapi",
    srcs = [
        "routes.go",
        "worker.go",
    ],
    importpath = "github.com/phodal/pero/server/internal/httpapi",
    visibility = ["//server:__subpackages__"],
    deps = [
        "//server/internal/store",
        "@com_github_jackc_pgx_v5//pgconn",
    ],
)

go_test(
    name = "httpapi_test",
    srcs = ["integration_test.go"],
    env = {"PERO_REQUIRE_TEST_DATABASE": "1"},
    env_inherit = ["PERO_TEST_DATABASE_URL"],
    tags = [
        "local",
        "manual",
        "no-cache",
        "no-remote",
    ],
    visibility = ["//server:__pkg__"],
    deps = [
        ":httpapi",
        "//server/internal/store",
        "@com_github_jackc_pgx_v5//:pgx",
        "@com_github_jackc_pgx_v5//pgxpool",
    ],
)
