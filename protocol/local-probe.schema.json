{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bootstrap echo request",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "text"],
  "properties": {
    "id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "text": { "type": "string", "minLength": 1, "maxLength": 4096 }
  }
}
