load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "pero-agent-acp_lib",
    srcs = [
        "compaction.go",
        "main.go",
        "sandbox_options.go",
    ],
    importpath = "github.com/phodal/pero/harness/go/cmd/pero-agent-acp",
    visibility = ["//visibility:private"],
    deps = [
        "//acp",
        "//harness",
        "//nativetools",
        "//permissionpresets",
        "//providers/openai",
        "//sandbox",
        "//skills",
    ],
)

go_binary(
    name = "pero-agent-acp",
    embed = [":pero-agent-acp_lib"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "pero-agent-acp_test",
    srcs = [
        "compaction_test.go",
        "compaction_wire_test.go",
        "main_test.go",
        "sandbox_options_test.go",
    ],
    embed = [":pero-agent-acp_lib"],
    deps = [
        "//harness",
        "//providers/openai",
    ],
)
